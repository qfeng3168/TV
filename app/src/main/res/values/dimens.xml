<?xml version="1.0" encoding="utf-8"?>
<resources>

    <dimen name="kiwi_radius_xs">4dp</dimen>
    <dimen name="kiwi_radius_sm">8dp</dimen>
    <dimen name="kiwi_radius_md">12dp</dimen>
    <dimen name="kiwi_radius_lg">16dp</dimen>
    <dimen name="kiwi_radius_pill">28dp</dimen>

    <dimen name="kiwi_space_xs">4dp</dimen>
    <dimen name="kiwi_space_sm">8dp</dimen>
    <dimen name="kiwi_space_md">16dp</dimen>
    <dimen name="kiwi_space_lg">24dp</dimen>
    <dimen name="kiwi_space_xl">32dp</dimen>
    <dimen name="kiwi_space_xxl">48dp</dimen>

    <dimen name="kiwi_focus_stroke">2dp</dimen>

    <!--
      主页尺寸取自银河奇异果 16.9.0 实机截图（1920x1080，density 320）。
      App 通过 leanback/AndroidManifest.xml 的 design_width_in_dp=960 把逻辑宽度锁成
      960dp，因此实际渲染密度为 2.0：dp = 截图像素 / 2。下列数值即按此换算。
        顶栏        ~110px -> 55dp
        导航栏宽     228px -> 114dp     导航项高 60px -> 30dp（选中药丸实测 228x60px）
        导航项间距   15px ->   8dp
        内容左边距   324px -> 162dp（24 外边距 + 114 导航 + 24 间距）

      导航字号按「字进距」而不是「墨迹高度」反推：奇异果 2 字标签宽 57px、3 字标签
      85px，即 14.2dp/字（≈15sp）。先前把 40px 墨迹高当成字号 20sp 是错的 —— 20sp
      会把「热播剧集」这类 4 字分类名挤成「热播…」。故取 16sp + 18dp 内边距。
    -->

    <!-- 顶部条 -->
    <dimen name="kiwi_topbar_height">55dp</dimen>
    <dimen name="kiwi_topbar_padding">20dp</dimen>
    <dimen name="kiwi_logo_size">26dp</dimen>
    <dimen name="kiwi_icon_box">36dp</dimen>

    <!-- 外边距：左栏左留白 24dp、两栏间距 24dp、右留白 24dp -->
    <dimen name="kiwi_body_padding">24dp</dimen>
    <dimen name="kiwi_body_gap">24dp</dimen>

    <!-- 左侧分类导航 -->
    <dimen name="kiwi_nav_width">114dp</dimen>
    <dimen name="kiwi_nav_item_height">30dp</dimen>
    <dimen name="kiwi_nav_item_padding">18dp</dimen>
    <dimen name="kiwi_nav_gap">8dp</dimen>
    <dimen name="kiwi_radius_nav">5dp</dimen>
    <dimen name="kiwi_nav_divider_height">1dp</dimen>

    <!-- 内容区 -->
    <dimen name="kiwi_content_gap">12dp</dimen>

    <!-- 卡片文字：图 -> 标题 8dp，标题 -> 副标题 2dp -->
    <dimen name="kiwi_card_gap">8dp</dimen>
    <dimen name="kiwi_text_gap">2dp</dimen>

    <!-- 首页大图 Banner：奇异果 732x298px -> 366x149dp -->
    <dimen name="kiwi_banner_height">149dp</dimen>
    <dimen name="kiwi_banner_padding">24dp</dimen>
    <dimen name="kiwi_radius_banner">4dp</dimen>
    <dimen name="kiwi_radius_tag">4dp</dimen>

</resources>
