<resources>

    <style name="Vod">
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="Vod.Grid">
        <item name="cornerSizeTopLeft">@dimen/kiwi_radius_md</item>
        <item name="cornerSizeTopRight">@dimen/kiwi_radius_md</item>
    </style>

    <!-- 首页推荐位：整块大图，四角都收。显式挂到 Vod 基础样式，否则 aapt2 会按点号去解析不存在的 @style/Home -->
    <style name="Home.Banner" parent="Vod">
        <item name="cornerSize">@dimen/kiwi_radius_lg</item>
    </style>

    <style name="Vod.Grid.Large">
        <item name="cornerSize">@dimen/kiwi_radius_md</item>
    </style>

    <style name="Vod.Circle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Vod.List">
        <item name="cornerSizeTopLeft">@dimen/kiwi_radius_md</item>
        <item name="cornerSizeBottomLeft">@dimen/kiwi_radius_md</item>
    </style>

    <style name="Player">
        <item name="resize_mode">fit</item>
        <item name="use_artwork">true</item>
        <item name="use_controller">false</item>
    </style>

    <style name="Player.Vod">
        <item name="keep_content_on_player_reset">false</item>
    </style>

    <style name="Player.Live">
        <item name="keep_content_on_player_reset">true</item>
    </style>

    <!-- 播放进度条：已播放段品牌绿、缓冲段半透明绿、未播放段暗灰 -->
    <style name="Player.Seek">
        <item name="played_color">@color/brand_primary</item>
        <item name="buffered_color">@color/brand_primary_dim</item>
        <item name="unplayed_color">@color/black_40</item>
        <item name="played_color">@color/brand_primary</item>
    </style>

</resources>
