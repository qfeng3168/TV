<resources>

    <style name="Theme.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/brand_primary_deep</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/brand_primary_fill</item>
        <item name="colorOnSecondaryContainer">@color/brand_primary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/on_surface_high</item>
        <item name="colorSurfaceVariant">@color/surface_raised</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_medium</item>
        <item name="colorOutline">@color/outline_subtle</item>
        <item name="colorOutlineVariant">@color/outline_subtle</item>
        <item name="android:colorBackground">@color/surface_base</item>
        <item name="android:windowBackground">@color/surface_base</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowAnimationStyle">@style/NoAnim</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="windowSplashScreenBackground">@color/surface_base</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="Theme.App" parent="Theme.Base" />

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowBackground">@color/grey_800</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="NoAnim">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="Shadow">
        <item name="android:shadowColor">#B0000000</item>
        <item name="android:shadowDx">1.5</item>
        <item name="android:shadowDy">1.5</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/selector_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:nextFocusUp">@id/exo_progress</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Kiwi.Text.Display">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/on_surface_high</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Kiwi.Text.Title">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/on_surface_high</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Kiwi.Text.Subtitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/on_surface_high</item>
    </style>

    <style name="Kiwi.Text.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/on_surface_medium</item>
    </style>

    <style name="Kiwi.Text.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_surface_low</item>
    </style>

</resources>
