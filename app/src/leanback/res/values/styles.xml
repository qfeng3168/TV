<resources>

    <style name="Theme.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/brand_primary_deep</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/brand_primary_fill</item>
        <item name="colorOnSecondaryContainer">@color/brand_primary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/on_surface_high</item>
        <item name="colorSurfaceVariant">@color/surface_raised</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_medium</item>
        <item name="colorOutline">@color/outline_subtle</item>
        <item name="colorOutlineVariant">@color/outline_subtle</item>
        <item name="android:colorBackground">@color/surface_base</item>
        <item name="android:windowBackground">@color/surface_base</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowAnimationStyle">@style/NoAnim</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="windowSplashScreenBackground">@color/surface_base</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="Theme.App" parent="Theme.Base" />

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowBackground">@color/grey_800</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="NoAnim">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="Shadow">
        <item name="android:shadowColor">#B0000000</item>
        <item name="android:shadowDx">1.5</item>
        <item name="android:shadowDy">1.5</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/selector_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:nextFocusUp">@id/exo_progress</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 基样式本身是点号命名，没有显式父级就会去继承不存在的 Kiwi，
         所以锚到 Material3 的同名刻度上；下面的五个派生样式各自覆盖字号与字色 -->
    <style name="Kiwi.Text" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/on_surface_high</item>
    </style>

    <style name="Kiwi.Text.Display" parent="Kiwi.Text">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Kiwi.Text.Title" parent="Kiwi.Text">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Kiwi.Text.Subtitle" parent="Kiwi.Text">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Kiwi.Text.BodyLarge" parent="Kiwi.Text">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Kiwi.Text.Body" parent="Kiwi.Text">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/on_surface_medium</item>
    </style>

    <style name="Kiwi.Text.Caption" parent="Kiwi.Text">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_surface_low</item>
    </style>

    <!-- 品牌名：设计稿 38px @2x = 19sp -->
    <style name="Kiwi.Text.Brand" parent="Kiwi.Text">
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- 分类导航项：设计稿 28px @2x = 14sp -->
    <style name="Kiwi.Text.Nav" parent="Kiwi.Text">
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 内容行标题：设计稿 36px @2x = 18sp -->
    <style name="Kiwi.Text.RowTitle" parent="Kiwi.Text">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Banner 主标题：设计稿 56px @2x = 28sp -->
    <style name="Kiwi.Text.BannerTitle" parent="Kiwi.Text">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface_high</item>
    </style>

    <!-- Banner 标签：设计稿 24px @2x = 12sp -->
    <style name="Kiwi.Text.Tag" parent="Kiwi.Text">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- 大字报级，用于设置页版本号、状态指示器、时间显示 -->
    <style name="Kiwi.Text.Hero" parent="Kiwi.Text">
        <item name="android:textSize">64sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>

</resources>
