<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 焦点落在「半透明深底 + 品牌绿描边」上，文字必须保持白色 -->
    <item android:color="@color/on_surface_high" android:state_focused="true" />
    <!-- 选中是实心品牌绿底，只有深色文字才有足够对比度 -->
    <item android:color="@color/on_brand" android:state_selected="true" />
    <item android:color="@color/on_brand" android:state_checked="true" />
    <item android:color="@color/on_surface_high" />
</selector>
