<?xml version="1.0" encoding="utf-8"?>
<!-- 分类导航项：对齐奇异果实测——项高 30dp、内容左内边距 18dp、字号 16sp。
     项宽由容器固定为 kiwi_nav_width(114dp，与奇异果药丸实测宽度一致)，文字左对齐，
     宽度不随内容变化。 -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/kiwi_nav_item_height"
    android:background="@drawable/selector_home_nav"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/kiwi_nav_item_padding"
    android:paddingEnd="@dimen/kiwi_nav_item_padding">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text"
        style="@style/Kiwi.Text.Nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:shadowColor="@color/black_70"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:singleLine="true"
        tools:text="电影" />

</androidx.appcompat.widget.LinearLayoutCompat>
