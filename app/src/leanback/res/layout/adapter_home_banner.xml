<?xml version="1.0" encoding="utf-8"?>
<!--
  首页大图 Banner：设计稿「首页Banner」= 260px @2x = 130dp 高、圆角 16px = 8dp、
  内留白 48px = 24dp，信息层（标签 / 标题 / 副标题）纵向排布、间距 16px = 8dp，
  整体贴左上角。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/kiwi_banner_height"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="@drawable/selector_home_banner">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_card"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/Home.Banner" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_home_banner_scrim" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="vertical"
        android:padding="@dimen/kiwi_banner_padding">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tag"
            style="@style/Kiwi.Text.Tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_home_banner_tag"
            android:singleLine="true"
            android:textColor="@color/on_brand"
            tools:text="独播 · 4K HDR" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/name"
            style="@style/Kiwi.Text.BannerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kiwi_space_sm"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/on_surface_high"
            tools:text="山河故人" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/remark"
            style="@style/Kiwi.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kiwi_space_xs"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/on_surface_medium"
            tools:text="年度悬疑巨制 · 全 24 集 · 更新至第 12 集" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>
