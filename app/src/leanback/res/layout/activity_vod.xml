<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部品牌条：标识 + 搜索（分类导航移到左侧） -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/kiwi_space_xxl"
        android:paddingEnd="@dimen/kiwi_space_xl">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_home_logo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/search"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/selector_home_nav"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_home_search" />

        </FrameLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- 主体：左侧分类导航 + 右侧内容 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/nav"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/kiwi_space_lg"
            android:paddingEnd="@dimen/kiwi_space_sm"
            android:paddingTop="@dimen/kiwi_space_md"
            android:paddingBottom="@dimen/kiwi_space_md"
            app:focusOutEnd="false"
            app:focusOutFront="false" />

        <com.fongmi.android.tv.ui.custom.CustomViewPager
            android:id="@+id/pager"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
